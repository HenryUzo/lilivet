NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
CORS_ORIGIN="http://localhost:3000,https://lili-frontend-plum.vercel.app,https://liliveterinaryhospital.com,https://www.liliveterinaryhospital.com"
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_KEY_PREFIX="uploads"
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=10
DRAFT_EXPIRY_HOURS=72
UNATTACHED_FILE_EXPIRY_HOURS=24
DUPLICATE_WINDOW_HOURS=48
CLINIC_NOTIFICATION_EMAIL="frontdesk@lilivethospital.example"
MAIL_FROM="Lili Vet Hospital <no-reply@lilivethospital.example>"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
JWT_ISSUER="lili-vet-backend"
JWT_AUDIENCE="lili-vet-staff"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID=""
STAFF_SEED_EMAIL="admin@lilivethospital.example"
STAFF_SEED_PASSWORD="replace-with-a-strong-temporary-password"
