generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Owner {
  id                     String                  @id @default(cuid())
  firstName              String
  lastName               String
  email                  String?
  phoneNumber            String
  normalizedPhone        String?
  preferredContactMethod PreferredContactMethod?
  pets                   Pet[]
  appointmentRequests    AppointmentRequest[]
  newPatientRequests     NewPatientRequest[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([email])
  @@index([phoneNumber])
  @@index([normalizedPhone])
}

model Pet {
  id                  String               @id @default(cuid())
  ownerId             String
  owner               Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  species             PetSpecies
  breed               String?
  approximateAgeYears Int?
  age                 String?
  sex                 PetSex
  weightLbs           Decimal?             @db.Decimal(6, 2)
  spayedNeutered      Boolean?
  currentMedications  String?
  existingConditions  String?
  appointmentRequests AppointmentRequest[]
  newPatientRequests  NewPatientRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([ownerId, name])
  @@index([ownerId, species])
}

model AppointmentDraft {
  id           String @id @default(cuid())
  sessionToken String @unique

  visitType VisitType?

  petName             String?
  species             PetSpecies?
  breed               String?
  approximateAgeYears Int?
  sex                 PetSex?
  weightLbs           Decimal?    @db.Decimal(6, 2)

  firstName              String?
  lastName               String?
  email                  String?
  phoneNumber            String?
  preferredContactMethod PreferredContactMethod?

  preferredSelections Json?
  timezone            String?

  symptomsOrConcerns   String?
  currentMedications   String?
  previousVeterinarian String?
  symptomDuration      String?

  lastCompletedStep Int       @default(0)
  expiresAt         DateTime
  submittedAt       DateTime?

  appointmentRequestId String?             @unique
  appointmentRequest   AppointmentRequest? @relation(fields: [appointmentRequestId], references: [id], onDelete: SetNull)
  rescheduleToken      AppointmentRescheduleToken?

  files UploadedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionToken])
  @@index([expiresAt])
  @@index([submittedAt])
  @@index([phoneNumber])
  @@index([email])
  @@index([petName])
}

model AppointmentRequest {
  id String @id @default(cuid())

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  draft AppointmentDraft?

  visitType VisitType
  status    AppointmentRequestStatus @default(PENDING_REVIEW)

  confirmedStartAt    DateTime?
  confirmedEndAt      DateTime?
  confirmedTimezone   String?
  confirmedByStaffUserId String?
  confirmedByStaffUser StaffUser? @relation(fields: [confirmedByStaffUserId], references: [id], onDelete: SetNull)
  rescheduleRequestedAt      DateTime?
  rescheduleResponseDeadline DateTime?
  rescheduleEmailSentAt      DateTime?
  rescheduleTokenIssuedAt    DateTime?
  rescheduledFromAppointmentRequestId String?
  rescheduledFromAppointmentRequest   AppointmentRequest?  @relation("AppointmentRequestReschedulesFrom", fields: [rescheduledFromAppointmentRequestId], references: [id], onDelete: SetNull)
  rescheduleReplacementRequests       AppointmentRequest[] @relation("AppointmentRequestReschedulesFrom")
  replacementAppointmentRequestId     String?             @unique
  replacementAppointmentRequest       AppointmentRequest? @relation("AppointmentRequestReplacement", fields: [replacementAppointmentRequestId], references: [id], onDelete: SetNull)
  replacedOverdueAppointmentRequest   AppointmentRequest? @relation("AppointmentRequestReplacement")

  preferredSelections     Json
  timezone                String
  preferredDateSelections AppointmentPreferredDate[]
  rescheduleTokens        AppointmentRescheduleToken[]

  calendarEventId     String?
  calendarEventUrl    String?
  calendarSyncStatus  CalendarSyncStatus @default(NOT_SYNCED)
  calendarSyncedAt    DateTime?
  calendarSyncError   String?

  symptomsOrConcerns   String?
  currentMedications   String?
  previousVeterinarian String?
  symptomDuration      String?

  possibleDuplicate Boolean              @default(false)
  duplicateOfId     String?
  duplicateOf       AppointmentRequest?  @relation("AppointmentRequestDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        AppointmentRequest[] @relation("AppointmentRequestDuplicates")

  files UploadedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ownerId])
  @@index([petId])
  @@index([duplicateOfId])
  @@index([confirmedByStaffUserId])
  @@index([calendarSyncStatus])
  @@index([rescheduledFromAppointmentRequestId])
  @@index([replacementAppointmentRequestId])
  @@index([rescheduleResponseDeadline])
}

model AppointmentPreferredDate {
  appointmentRequestId String
  appointmentRequest   AppointmentRequest @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)
  dateKey              String

  @@id([appointmentRequestId, dateKey])
  @@index([dateKey, appointmentRequestId])
}

model NewPatientRequest {
  id String @id @default(cuid())

  ownerFullName    String
  ownerEmail       String?
  ownerPhoneNumber String

  petName            String
  species            PetSpecies
  breed              String?
  age                String?
  sex                PetSex
  weightLbs          Decimal?   @db.Decimal(6, 2)
  spayedNeutered     Boolean?
  currentMedications String?
  existingConditions String?

  reasonForVisit           String
  isUrgent                 Boolean   @default(false)
  preferredDateTime        DateTime?
  timezone                 String?
  previousVetClinic        String?
  consentToElectronicComms Boolean   @default(false)
  referralSource                NewPatientReferralSource?
  referralSourceOther           String?
  referralSourceCapturedAt      DateTime?
  referralSourceCaptureTokenHash String?
  referralSourceCaptureTokenExpiresAt DateTime?

  ownerId String?
  owner   Owner?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  petId String?
  pet   Pet?    @relation(fields: [petId], references: [id], onDelete: SetNull)

  possibleDuplicate Boolean             @default(false)
  duplicateOfId     String?
  duplicateOf       NewPatientRequest?  @relation("NewPatientRequestDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        NewPatientRequest[] @relation("NewPatientRequestDuplicates")

  files UploadedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([preferredDateTime])
  @@index([ownerEmail])
  @@index([ownerPhoneNumber])
  @@index([petName])
  @@index([ownerId])
  @@index([petId])
  @@index([duplicateOfId])
  @@index([referralSource])
}

model UploadedFile {
  id              String  @id @default(cuid())
  originalName    String
  storedName      String
  mimeType        String
  sizeBytes       Int
  storageProvider String  @default("local")
  storageKey      String
  publicUrl       String?

  attachmentStatus FileAttachmentStatus @default(UNATTACHED)
  expiresAt        DateTime?

  appointmentDraftId String?
  appointmentDraft   AppointmentDraft? @relation(fields: [appointmentDraftId], references: [id], onDelete: SetNull)

  appointmentRequestId String?
  appointmentRequest   AppointmentRequest? @relation(fields: [appointmentRequestId], references: [id], onDelete: SetNull)

  newPatientRequestId String?
  newPatientRequest   NewPatientRequest? @relation(fields: [newPatientRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attachmentStatus])
  @@index([expiresAt])
  @@index([appointmentDraftId])
  @@index([appointmentRequestId])
  @@index([newPatientRequestId])
}

model WellnessPlan {
  id                 String                          @id @default(cuid())
  planKey            String                          @unique
  species            WellnessPlanSpecies
  lifeStage          WellnessPlanLifeStage
  tier               WellnessPlanTier
  displayName        String
  enrollmentFee      Decimal                         @db.Decimal(10, 2)
  monthlyFee         Decimal                         @db.Decimal(10, 2)
  annualPrice        Decimal                         @db.Decimal(10, 2)
  isActive           Boolean                         @default(true)
  benefits           WellnessPlanBenefit[]
  milestoneTemplates WellnessPlanMilestoneTemplate[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([species, lifeStage, tier])
  @@index([isActive])
}

model WellnessPlanBenefit {
  id                 String                          @id @default(cuid())
  wellnessPlanId     String
  wellnessPlan       WellnessPlan                    @relation(fields: [wellnessPlanId], references: [id], onDelete: Cascade)
  sortOrder          Int
  label              String
  benefitType        WellnessPlanBenefitType
  serviceType        WellnessPlanServiceType?
  includedQuantity   Int?
  coverageLabel      String?
  discountPercent    Int?
  creditAmount       Decimal?                        @db.Decimal(10, 2)
  notes              String?
  milestoneTemplates WellnessPlanMilestoneTemplate[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([wellnessPlanId, sortOrder])
}

model WellnessPlanMilestoneTemplate {
  id                    String                  @id @default(cuid())
  wellnessPlanId        String
  wellnessPlan          WellnessPlan            @relation(fields: [wellnessPlanId], references: [id], onDelete: Cascade)
  wellnessPlanBenefitId String
  wellnessPlanBenefit   WellnessPlanBenefit     @relation(fields: [wellnessPlanBenefitId], references: [id], onDelete: Cascade)
  sortOrder             Int
  displayName           String
  serviceType           WellnessPlanServiceType
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([wellnessPlanId, sortOrder])
  @@index([wellnessPlanBenefitId])
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)
  confirmedAppointments AppointmentRequest[]
  createdRescheduleTokens AppointmentRescheduleToken[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([isActive])
}

model PetCareReviewer {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  email       String?
  credentials String
  role        String
  photoUrl    String?
  shortBio    String
  isActive    Boolean          @default(true)
  articles    PetCareArticle[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([email])
}

model PetCareArticle {
  id                     String                  @id @default(cuid())
  slug                   String                  @unique
  title                  String
  seoTitle               String
  seoDescription         String
  excerpt                String
  summary                String
  categorySlug           String
  categoryLabel          String
  tags                   String[]
  heroImageUrl           String?
  heroImageKey           String?
  heroImageFile          String?
  heroImageAlt           String
  authorName             String
  authorRole             String
  reviewerId             String?
  reviewer               PetCareReviewer?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  previewShares          PetCarePreviewShare[]
  status                 PetCarePublishingStatus @default(DRAFT)
  reviewStatus           PetCareReviewStatus     @default(NOT_REVIEWED)
  reviewedAt             DateTime?
  reviewDueAt             DateTime?
  publishedAt            DateTime?
  readingTimeMinutes     Int
  relatedService         Json
  relatedArticleSlugs    String[]
  featured               Boolean                 @default(false)
  seasonal               Boolean                 @default(false)
  popular                Boolean                 @default(false)
  keyTakeaways           Json
  monitorAtHome          Json
  warningCallout         String?
  vetQuote               String?
  faqs                   Json
  references             Json
  sections               Json
  submittedForReviewAt   DateTime?
  approvedAt             DateTime?
  archivedAt             DateTime?
  createdByStaffUserId   String?
  updatedByStaffUserId   String?
  approvedByStaffUserId  String?
  publishedByStaffUserId String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, updatedAt])
  @@index([categorySlug, status])
  @@index([reviewerId])
  @@index([reviewDueAt])
  @@index([featured, status])
}

model PetCarePreviewShare {
  id                   String                  @id @default(cuid())
  articleId            String
  article              PetCareArticle          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tokenHash            String                  @unique
  shareType            PetCarePreviewShareType
  expiresAt            DateTime
  revokedAt            DateTime?
  createdByStaffUserId String
  invitationRecipient String?
  invitationSentAt     DateTime?
  comments             PetCarePreviewComment[]
  createdAt            DateTime                @default(now())

  @@index([articleId, createdAt])
  @@index([expiresAt])
  @@index([invitationSentAt])
}

model PetCarePreviewComment {
  id         String              @id @default(cuid())
  shareId    String
  share      PetCarePreviewShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  authorName String
  comment    String
  createdAt  DateTime            @default(now())

  @@index([shareId, createdAt])
}

model AppointmentRescheduleToken {
  id                String             @id @default(cuid())
  appointmentRequestId String
  appointmentRequest AppointmentRequest @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)
  appointmentDraftId String            @unique
  appointmentDraft   AppointmentDraft  @relation(fields: [appointmentDraftId], references: [id], onDelete: Cascade)
  tokenHash         String             @unique
  expiresAt         DateTime
  usedAt            DateTime?
  createdByStaffUserId String
  createdByStaffUser StaffUser         @relation(fields: [createdByStaffUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())

  @@index([appointmentRequestId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdByStaffUserId])
}

enum AppointmentRequestStatus {
  PENDING_REVIEW
  CONFIRMED
  OVERDUE
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum VisitType {
  URGENT_CARE
  WELLNESS_EXAM
  VACCINATIONS
  DENTAL_CARE
  SURGERY
  DIAGNOSTICS
  NEW_PATIENT_VISIT
  OTHER
}

enum PetSpecies {
  DOG
  CAT
}

enum PetSex {
  MALE
  FEMALE
}

enum PreferredContactMethod {
  CALL
  TEXT
  EMAIL
}

enum FileAttachmentStatus {
  UNATTACHED
  ATTACHED_TO_DRAFT
  ATTACHED
}

enum StaffRole {
  ADMIN
  STAFF
}

enum CalendarSyncStatus {
  NOT_SYNCED
  SYNCED
  FAILED
}

enum NewPatientReferralSource {
  PET_PARADISE
  WEBSITE
  GOOGLE
  PET_BARN
  WELCOME_HOME_MAGAZINE
  REFERRED_BY_ANOTHER_VETERINARIAN
  REFERRED_BY_FRIEND_OR_FAMILY_MEMBER
  OTHER
}

enum WellnessPlanSpecies {
  DOG
  CAT
}

enum WellnessPlanLifeStage {
  PUPPY
  KITTEN
  ADULT
}

enum WellnessPlanTier {
  ESSENTIAL
  COMPLETE
}

enum WellnessPlanBenefitType {
  SERVICE
  DISCOUNT
  CREDIT
  OPTIONAL_DISCOUNTED_ITEM
}

enum WellnessPlanServiceType {
  COMPREHENSIVE_WELLNESS_EXAM
  WELLNESS_PUPPY_EXAM
  WELLNESS_KITTEN_EXAM
  DOG_CORE_VACCINE_SERIES
  CAT_CORE_VACCINE_SERIES
  FECAL_PARASITE_EXAM_AND_DEWORMING
  FECAL_PARASITE_EXAM
  HEARTWORM_TEST
  FELV_FIV_TEST
  EARLY_DIAGNOSTIC_BLOODWORK
  ANNUAL_WELLNESS_BLOODWORK
  URINALYSIS
  BLOOD_PRESSURE_SCREENING
  TECH_VISIT
}

enum PetCarePublishingStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum PetCareReviewStatus {
  NOT_REVIEWED
  IN_REVIEW
  MEDICALLY_REVIEWED
}

enum PetCarePreviewShareType {
  COMMENT
  REVIEWER
}
