generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Owner {
  id                     String                  @id @default(cuid())
  firstName              String
  lastName               String
  email                  String?
  phoneNumber            String
  normalizedPhone        String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  state                  String?
  postalCode             String?
  preferredContactMethod PreferredContactMethod?
  pets                   Pet[]
  appointmentRequests    AppointmentRequest[]
  newPatientRequests     NewPatientRequest[]
  clientProfile          ClientProfile?
  clientLifecycleRecords ClientLifecycleRecord[]
  contactMethods         OwnerContactMethod[]
  externalClientRecords  ExternalClientRecord[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([email])
  @@index([phoneNumber])
  @@index([normalizedPhone])
}

model Pet {
  id                     String                  @id @default(cuid())
  ownerId                String
  owner                  Owner                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                   String
  species                PetSpecies
  breed                  String?
  approximateAgeYears    Int?
  age                    String?
  sex                    PetSex
  weightLbs              Decimal?                @db.Decimal(6, 2)
  spayedNeutered         Boolean?
  currentMedications     String?
  existingConditions     String?
  appointmentRequests    AppointmentRequest[]
  newPatientRequests     NewPatientRequest[]
  clientLifecycleRecords ClientLifecycleRecord[]
  externalClientRecords  ExternalClientRecord[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([ownerId, name])
  @@index([ownerId, species])
}

model AppointmentDraft {
  id           String @id @default(cuid())
  sessionToken String @unique

  visitType VisitType?

  petName             String?
  species             PetSpecies?
  breed               String?
  approximateAgeYears Int?
  sex                 PetSex?
  weightLbs           Decimal?    @db.Decimal(6, 2)

  firstName              String?
  lastName               String?
  email                  String?
  phoneNumber            String?
  preferredContactMethod PreferredContactMethod?
  marketingEmailOptIn    Boolean                 @default(false)
  marketingSmsOptIn      Boolean                 @default(false)

  preferredSelections Json?
  timezone            String?

  symptomsOrConcerns   String?
  currentMedications   String?
  previousVeterinarian String?
  symptomDuration      String?

  lastCompletedStep Int       @default(0)
  expiresAt         DateTime
  submittedAt       DateTime?

  appointmentRequestId String?                     @unique
  appointmentRequest   AppointmentRequest?         @relation(fields: [appointmentRequestId], references: [id], onDelete: SetNull)
  rescheduleToken      AppointmentRescheduleToken?

  files UploadedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionToken])
  @@index([expiresAt])
  @@index([submittedAt])
  @@index([phoneNumber])
  @@index([email])
  @@index([petName])
}

model AppointmentRequest {
  id String @id @default(cuid())

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Restrict)

  draft AppointmentDraft?

  visitType VisitType
  status    AppointmentRequestStatus @default(PENDING_REVIEW)

  confirmedStartAt                    DateTime?
  confirmedEndAt                      DateTime?
  confirmedTimezone                   String?
  confirmedByStaffUserId              String?
  confirmedByStaffUser                StaffUser?           @relation(fields: [confirmedByStaffUserId], references: [id], onDelete: SetNull)
  rescheduleRequestedAt               DateTime?
  rescheduleResponseDeadline          DateTime?
  rescheduleEmailSentAt               DateTime?
  rescheduleTokenIssuedAt             DateTime?
  rescheduledFromAppointmentRequestId String?
  rescheduledFromAppointmentRequest   AppointmentRequest?  @relation("AppointmentRequestReschedulesFrom", fields: [rescheduledFromAppointmentRequestId], references: [id], onDelete: SetNull)
  rescheduleReplacementRequests       AppointmentRequest[] @relation("AppointmentRequestReschedulesFrom")
  replacementAppointmentRequestId     String?              @unique
  replacementAppointmentRequest       AppointmentRequest?  @relation("AppointmentRequestReplacement", fields: [replacementAppointmentRequestId], references: [id], onDelete: SetNull)
  replacedOverdueAppointmentRequest   AppointmentRequest?  @relation("AppointmentRequestReplacement")

  preferredSelections     Json
  timezone                String
  preferredDateSelections AppointmentPreferredDate[]
  rescheduleTokens        AppointmentRescheduleToken[]

  calendarEventId    String?
  calendarEventUrl   String?
  calendarSyncStatus CalendarSyncStatus @default(NOT_SYNCED)
  calendarSyncedAt   DateTime?
  calendarSyncError  String?

  symptomsOrConcerns   String?
  currentMedications   String?
  previousVeterinarian String?
  symptomDuration      String?

  possibleDuplicate Boolean              @default(false)
  duplicateOfId     String?
  duplicateOf       AppointmentRequest?  @relation("AppointmentRequestDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        AppointmentRequest[] @relation("AppointmentRequestDuplicates")

  files UploadedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ownerId])
  @@index([petId])
  @@index([duplicateOfId])
  @@index([confirmedByStaffUserId])
  @@index([calendarSyncStatus])
  @@index([rescheduledFromAppointmentRequestId])
  @@index([replacementAppointmentRequestId])
  @@index([rescheduleResponseDeadline])
}

model AppointmentPreferredDate {
  appointmentRequestId String
  appointmentRequest   AppointmentRequest @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)
  dateKey              String

  @@id([appointmentRequestId, dateKey])
  @@index([dateKey, appointmentRequestId])
}

model NewPatientRequest {
  id String @id @default(cuid())

  ownerFullName    String
  ownerEmail       String?
  ownerPhoneNumber String

  petName            String
  species            PetSpecies
  breed              String?
  age                String?
  sex                PetSex
  weightLbs          Decimal?   @db.Decimal(6, 2)
  spayedNeutered     Boolean?
  currentMedications String?
  existingConditions String?

  reasonForVisit                      String
  isUrgent                            Boolean                   @default(false)
  preferredDateTime                   DateTime?
  timezone                            String?
  previousVetClinic                   String?
  consentToElectronicComms            Boolean                   @default(false)
  marketingEmailOptIn                 Boolean                   @default(false)
  marketingSmsOptIn                   Boolean                   @default(false)
  referralSource                      NewPatientReferralSource?
  referralSourceOther                 String?
  referralSourceCapturedAt            DateTime?
  referralSourceCaptureTokenHash      String?
  referralSourceCaptureTokenExpiresAt DateTime?

  ownerId String?
  owner   Owner?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  petId String?
  pet   Pet?    @relation(fields: [petId], references: [id], onDelete: SetNull)

  possibleDuplicate Boolean             @default(false)
  duplicateOfId     String?
  duplicateOf       NewPatientRequest?  @relation("NewPatientRequestDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        NewPatientRequest[] @relation("NewPatientRequestDuplicates")

  files UploadedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([preferredDateTime])
  @@index([ownerEmail])
  @@index([ownerPhoneNumber])
  @@index([petName])
  @@index([ownerId])
  @@index([petId])
  @@index([duplicateOfId])
  @@index([referralSource])
}

model UploadedFile {
  id              String  @id @default(cuid())
  originalName    String
  storedName      String
  mimeType        String
  sizeBytes       Int
  storageProvider String  @default("local")
  storageKey      String
  publicUrl       String?

  attachmentStatus FileAttachmentStatus @default(UNATTACHED)
  expiresAt        DateTime?

  appointmentDraftId String?
  appointmentDraft   AppointmentDraft? @relation(fields: [appointmentDraftId], references: [id], onDelete: SetNull)

  appointmentRequestId String?
  appointmentRequest   AppointmentRequest? @relation(fields: [appointmentRequestId], references: [id], onDelete: SetNull)

  newPatientRequestId String?
  newPatientRequest   NewPatientRequest? @relation(fields: [newPatientRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attachmentStatus])
  @@index([expiresAt])
  @@index([appointmentDraftId])
  @@index([appointmentRequestId])
  @@index([newPatientRequestId])
}

model WellnessPlan {
  id                 String                          @id @default(cuid())
  planKey            String                          @unique
  species            WellnessPlanSpecies
  lifeStage          WellnessPlanLifeStage
  tier               WellnessPlanTier
  displayName        String
  enrollmentFee      Decimal                         @db.Decimal(10, 2)
  monthlyFee         Decimal                         @db.Decimal(10, 2)
  annualPrice        Decimal                         @db.Decimal(10, 2)
  isActive           Boolean                         @default(true)
  benefits           WellnessPlanBenefit[]
  milestoneTemplates WellnessPlanMilestoneTemplate[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([species, lifeStage, tier])
  @@index([isActive])
}

model WellnessPlanBenefit {
  id                 String                          @id @default(cuid())
  wellnessPlanId     String
  wellnessPlan       WellnessPlan                    @relation(fields: [wellnessPlanId], references: [id], onDelete: Cascade)
  sortOrder          Int
  label              String
  benefitType        WellnessPlanBenefitType
  serviceType        WellnessPlanServiceType?
  includedQuantity   Int?
  coverageLabel      String?
  discountPercent    Int?
  creditAmount       Decimal?                        @db.Decimal(10, 2)
  notes              String?
  milestoneTemplates WellnessPlanMilestoneTemplate[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([wellnessPlanId, sortOrder])
}

model WellnessPlanMilestoneTemplate {
  id                    String                  @id @default(cuid())
  wellnessPlanId        String
  wellnessPlan          WellnessPlan            @relation(fields: [wellnessPlanId], references: [id], onDelete: Cascade)
  wellnessPlanBenefitId String
  wellnessPlanBenefit   WellnessPlanBenefit     @relation(fields: [wellnessPlanBenefitId], references: [id], onDelete: Cascade)
  sortOrder             Int
  displayName           String
  serviceType           WellnessPlanServiceType
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([wellnessPlanId, sortOrder])
  @@index([wellnessPlanBenefitId])
}

model StaffUser {
  id                         String                       @id @default(cuid())
  email                      String                       @unique
  passwordHash               String
  role                       StaffRole                    @default(STAFF)
  isActive                   Boolean                      @default(true)
  sessionVersion             Int                          @default(0)
  mfaSecretEncrypted         String?
  mfaPendingSecretEncrypted  String?
  mfaEnabledAt               DateTime?
  invitationTokenHash        String?                      @unique
  invitationExpiresAt        DateTime?
  invitationAcceptedAt       DateTime?
  invitedByStaffUserId       String?
  invitedBy                  StaffUser?                   @relation("StaffInvitations", fields: [invitedByStaffUserId], references: [id], onDelete: SetNull)
  invitedStaffUsers          StaffUser[]                  @relation("StaffInvitations")
  permissions                StaffPermission[]
  accessAuditActions         StaffAccessAuditLog[]        @relation("StaffAccessAuditActor")
  accessAuditTargets         StaffAccessAuditLog[]        @relation("StaffAccessAuditTarget")
  mfaRecoveryCodes           StaffMfaRecoveryCode[]
  clientImportRuns           ClientImportRun[]            @relation("ClientImportInitiator")
  marketingCampaignsCreated  MarketingCampaign[]          @relation("MarketingCampaignCreator")
  marketingCampaignsApproved MarketingCampaign[]          @relation("MarketingCampaignApprover")
  marketingCampaignsSent     MarketingCampaign[]          @relation("MarketingCampaignSender")
  confirmedAppointments      AppointmentRequest[]
  createdRescheduleTokens    AppointmentRescheduleToken[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  @@index([email])
  @@index([isActive])
  @@index([invitationExpiresAt])
}

model StaffMfaRecoveryCode {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId, usedAt])
}

model OwnerContactMethod {
  id        String              @id @default(cuid())
  ownerId   String
  owner     Owner               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channel   OwnerContactChannel
  label     String?
  value     String
  isPrimary Boolean             @default(false)
  source    ClientDataSource?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([ownerId, channel, value])
  @@index([ownerId, channel])
}

model ExternalClientRecord {
  id                String           @id @default(cuid())
  ownerId           String
  owner             Owner            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petId             String
  pet               Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)
  source            ClientDataSource
  externalContactId String?
  externalPetId     String?
  contactStatus     String?
  lastSyncedAt      DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([source, externalContactId, externalPetId])
  @@index([ownerId])
  @@index([petId])
}

model StaffPermission {
  id          String             @id @default(cuid())
  staffUserId String
  staffUser   StaffUser          @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  key         StaffPermissionKey
  createdAt   DateTime           @default(now())

  @@unique([staffUserId, key])
  @@index([key])
}

model StaffAccessAuditLog {
  id           String     @id @default(cuid())
  actorId      String?
  actor        StaffUser? @relation("StaffAccessAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   StaffUser? @relation("StaffAccessAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
}

model ClientProfile {
  id                   String                       @id @default(cuid())
  ownerId              String                       @unique
  owner                Owner                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  emailMarketingStatus MarketingConsentStatus       @default(NOT_SUBSCRIBED)
  smsMarketingStatus   MarketingConsentStatus       @default(NOT_SUBSCRIBED)
  emailConsentAt       DateTime?
  smsConsentAt         DateTime?
  emailConsentSource   String?
  smsConsentSource     String?
  consents             ClientCommunicationConsent[]
  marketingDeliveries  MarketingCampaignDelivery[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@index([emailMarketingStatus])
  @@index([smsMarketingStatus])
}

model MarketingCampaign {
  id              String                      @id @default(cuid())
  name            String
  subject         String
  previewText     String?
  htmlContent     String
  textContent     String
  senderName      String
  senderEmail     String
  senderAddress   String
  audienceMode    MarketingAudienceMode       @default(CONSENTED_CLIENTS)
  customAudience  Json?
  contentBlocks   Json?
  templateId      String?
  recipientSelectionConfirmed Boolean @default(false)
  designConfigured Boolean @default(false)
  status          MarketingCampaignStatus     @default(DRAFT)
  audienceCount   Int                         @default(0)
  brevoCampaignId Int?                        @unique
  brevoListId     Int?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      StaffUser?                  @relation("MarketingCampaignApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       StaffUser                   @relation("MarketingCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sentById        String?
  sentBy          StaffUser?                  @relation("MarketingCampaignSender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  failureReason   String?
  deliveries      MarketingCampaignDelivery[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model MarketingEmailTemplate {
  id            String   @id @default(cuid())
  name          String
  contentBlocks Json
  htmlContent   String
  textContent   String
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([createdById, createdAt])
}

model MarketingCampaignDelivery {
  id                String                  @id @default(cuid())
  campaignId        String
  campaign          MarketingCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientProfileId   String?
  clientProfile     ClientProfile?          @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  recipientHash     String
  status            MarketingDeliveryStatus @default(QUEUED)
  providerMessageId String?
  eventAt           DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([campaignId, clientProfileId])
  @@index([clientProfileId, status])
  @@index([providerMessageId])
}

model MarketingEmailSuppression {
  id           String   @id @default(cuid())
  emailHash    String   @unique
  reason       String
  source       String
  suppressedAt DateTime @default(now())

  @@index([suppressedAt])
}

model ClientCommunicationConsent {
  id              String                 @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile          @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  channel         MarketingChannel
  action          MarketingConsentAction
  source          String
  policyVersion   String?
  recordedAt      DateTime               @default(now())

  @@index([clientProfileId, channel, recordedAt])
}

model ClientImportRun {
  id                     String     @id @default(cuid())
  initiatedByStaffUserId String?
  initiatedBy            StaffUser? @relation("ClientImportInitiator", fields: [initiatedByStaffUserId], references: [id], onDelete: SetNull)
  originalFileName       String
  sourceLabel            String     @default("New Client Tracker")
  totalRows              Int
  importedCount          Int
  updatedCount           Int
  skippedCount           Int
  skippedRows            Json?
  createdAt              DateTime   @default(now())

  @@index([createdAt])
  @@index([initiatedByStaffUserId, createdAt])
}

model ClientLifecycleRecord {
  id                        String       @id @default(cuid())
  ownerId                   String
  owner                     Owner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  petId                     String
  pet                       Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  newClientDate             DateTime     @default(now())
  leadSource                String?
  referredBy                String?
  regularVeterinarian       String?
  firstVisitType            String?
  doctorSeen                String?
  recheckRecommended        Boolean      @default(false)
  recheckScheduled          Boolean      @default(false)
  recheckDate               DateTime?
  recheckCompleted          Boolean      @default(false)
  followUpNeeded            Boolean      @default(false)
  firstVisitRevenue         Decimal?     @db.Decimal(10, 2)
  additionalServicesRevenue Decimal?     @db.Decimal(10, 2)
  wellnessPlan              String?
  clientStatus              ClientStatus @default(ACTIVE)
  lastVisitAt               DateTime?
  nextAppointmentAt         DateTime?
  notes                     String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([ownerId, petId])
  @@index([leadSource])
  @@index([clientStatus])
  @@index([recheckScheduled, recheckCompleted])
  @@index([newClientDate])
}

model PetCareReviewer {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  email       String?
  credentials String
  role        String
  photoUrl    String?
  shortBio    String
  isActive    Boolean          @default(true)
  articles    PetCareArticle[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([email])
}

model PetCareArticle {
  id                     String                  @id @default(cuid())
  slug                   String                  @unique
  title                  String
  seoTitle               String
  seoDescription         String
  excerpt                String
  summary                String
  categorySlug           String
  categoryLabel          String
  tags                   String[]
  heroImageUrl           String?
  heroImageKey           String?
  heroImageFile          String?
  heroImageAlt           String
  authorName             String
  authorRole             String
  reviewerId             String?
  reviewer               PetCareReviewer?        @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  previewShares          PetCarePreviewShare[]
  status                 PetCarePublishingStatus @default(DRAFT)
  reviewStatus           PetCareReviewStatus     @default(NOT_REVIEWED)
  reviewedAt             DateTime?
  reviewDueAt            DateTime?
  publishedAt            DateTime?
  readingTimeMinutes     Int
  relatedService         Json
  relatedArticleSlugs    String[]
  featured               Boolean                 @default(false)
  seasonal               Boolean                 @default(false)
  popular                Boolean                 @default(false)
  keyTakeaways           Json
  monitorAtHome          Json
  warningCallout         String?
  vetQuote               String?
  faqs                   Json
  references             Json
  sections               Json
  submittedForReviewAt   DateTime?
  approvedAt             DateTime?
  archivedAt             DateTime?
  createdByStaffUserId   String?
  updatedByStaffUserId   String?
  approvedByStaffUserId  String?
  publishedByStaffUserId String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, updatedAt])
  @@index([categorySlug, status])
  @@index([reviewerId])
  @@index([reviewDueAt])
  @@index([featured, status])
}

model PetCarePreviewShare {
  id                   String                  @id @default(cuid())
  articleId            String
  article              PetCareArticle          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tokenHash            String                  @unique
  shareType            PetCarePreviewShareType
  expiresAt            DateTime
  revokedAt            DateTime?
  createdByStaffUserId String
  invitationRecipient  String?
  invitationSentAt     DateTime?
  comments             PetCarePreviewComment[]
  createdAt            DateTime                @default(now())

  @@index([articleId, createdAt])
  @@index([expiresAt])
  @@index([invitationSentAt])
}

model PetCarePreviewComment {
  id         String              @id @default(cuid())
  shareId    String
  share      PetCarePreviewShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  authorName String
  comment    String
  createdAt  DateTime            @default(now())

  @@index([shareId, createdAt])
}

model AppointmentRescheduleToken {
  id                   String             @id @default(cuid())
  appointmentRequestId String
  appointmentRequest   AppointmentRequest @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)
  appointmentDraftId   String             @unique
  appointmentDraft     AppointmentDraft   @relation(fields: [appointmentDraftId], references: [id], onDelete: Cascade)
  tokenHash            String             @unique
  expiresAt            DateTime
  usedAt               DateTime?
  createdByStaffUserId String
  createdByStaffUser   StaffUser          @relation(fields: [createdByStaffUserId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())

  @@index([appointmentRequestId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdByStaffUserId])
}

enum AppointmentRequestStatus {
  PENDING_REVIEW
  CONFIRMED
  OVERDUE
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum VisitType {
  URGENT_CARE
  WELLNESS_EXAM
  VACCINATIONS
  DENTAL_CARE
  SURGERY
  DIAGNOSTICS
  NEW_PATIENT_VISIT
  OTHER
}

enum PetSpecies {
  DOG
  CAT
  UNKNOWN
}

enum PetSex {
  MALE
  FEMALE
  UNKNOWN
}

enum PreferredContactMethod {
  CALL
  TEXT
  EMAIL
}

enum FileAttachmentStatus {
  UNATTACHED
  ATTACHED_TO_DRAFT
  ATTACHED
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum OwnerContactChannel {
  PHONE
  EMAIL
}

enum ClientDataSource {
  WEAVE
  LILI_WEB
  MANUAL
}

enum StaffPermissionKey {
  APPOINTMENTS_VIEW
  APPOINTMENTS_MANAGE
  NEW_PATIENTS_VIEW
  PET_CARE_VIEW
  PET_CARE_EDIT
  PET_CARE_PUBLISH
  PET_CARE_REVIEWERS
  CLIENTS_VIEW
  CLIENTS_MANAGE
  CAMPAIGNS_VIEW
  CAMPAIGNS_MANAGE
}

enum MarketingCampaignStatus {
  DRAFT
  READY_TO_SEND
  SENDING
  SENT
  FAILED
}

enum MarketingAudienceMode {
  CONSENTED_CLIENTS
  SELECTED_EMAILS
}

enum MarketingDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
}

enum MarketingConsentStatus {
  NOT_SUBSCRIBED
  SUBSCRIBED
  UNSUBSCRIBED
  SUPPRESSED
}

enum MarketingChannel {
  EMAIL
  SMS
}

enum MarketingConsentAction {
